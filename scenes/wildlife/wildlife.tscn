cone_scene = ExtResource("8_cone")
editor_description = "Hands an ice cream to a few boardwalk guests who carry a cup, and sends a circling waterfront gull down to take a scoop every so often. How many cones, how often and how far a gull will dive are inspector controls; the cone itself is ice_cream_cone.tscn."
