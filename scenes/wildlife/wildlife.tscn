[node name="wildlife" type="Node3D"]
editor_description = "Persistent ambient bird layer. Move an instance or colony marker to move its home/flight centre; behavior ranges remain inspector controls. The northern offshore rocks are the gull nesting and roosting ground, while the park and other beaches remain active feeding territory. Birds are ordinary photographic subjects, not collectibles."

