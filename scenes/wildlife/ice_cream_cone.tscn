albedo_color = Color(0.82, 0.62, 0.36, 1)
roughness = 0.9

[sub_resource type="StandardMaterial3D" id="mat_scoop"]
albedo_color = Color(0.96, 0.62, 0.72, 1)
roughness = 0.7

