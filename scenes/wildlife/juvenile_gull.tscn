[ext_resource type="PackedScene" path="res://assets/wildlife/gull_juvenile.glb" id="2_model"]

[node name="juvenile_gull" type="Node3D"]
script = ExtResource("1_bird")
species = "gull"
juvenile = true
pose_root_path = NodePath("visual/juvenile_gull_model/juvenile_gull_model")
model_has_authored_plumage = true
