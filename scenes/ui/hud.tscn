[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scenes/ui/hud.gd" id="1_hud"]
[ext_resource type="Script" path="res://scenes/ui/viewfinder.gd" id="2_viewfinder"]
[ext_resource type="Script" path="res://scenes/ui/album_view.gd" id="3_album"]

[node name="hud" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="viewfinder" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("2_viewfinder")

[node name="flash" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(1, 1, 1, 1)

[node name="hint" type="Label" parent="."]
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = -44.0
offset_right = -24.0
offset_bottom = -18.0
grow_horizontal = 2
grow_vertical = 0
mouse_filter = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.65)
theme_override_colors/font_shadow_color = Color(0, 0, 0, 0.6)
theme_override_constants/shadow_offset_x = 1
theme_override_constants/shadow_offset_y = 1
text = "[F] camera — tap or hold    [click / Enter] shutter    [Space] jump    [Tab] album    [Esc] free mouse"

[node name="album_view" type="Control" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("3_album")

[node name="backdrop" type="ColorRect" parent="album_view"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.07, 0.07, 0.09, 0.93)

[node name="margin" type="MarginContainer" parent="album_view"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 40

[node name="layout" type="VBoxContainer" parent="album_view/margin"]
mouse_filter = 2
theme_override_constants/separation = 20

[node name="title" type="Label" parent="album_view/margin/layout"]
mouse_filter = 2
theme_override_colors/font_color = Color(0.9, 0.89, 0.86, 1)
text = "album"

[node name="grid" type="GridContainer" parent="album_view/margin/layout"]
size_flags_horizontal = 4
size_flags_vertical = 4
mouse_filter = 2
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 14
columns = 5

[node name="caption" type="Label" parent="album_view/margin/layout"]
mouse_filter = 2
theme_override_colors/font_color = Color(0.7, 0.69, 0.66, 1)
text = ""
