[node name="water" type="Node3D" parent="." unique_id=2075274657]

[node name="CW-AQ" type="Node3D" parent="water" unique_id=788854112]
editor_description = "D2 Coastal Creek's course: each Marker3D under points is a point of it in order. A point carrying level is the creek's bed there in world metres, where the rounded course turns at it; between two levels the bed falls evenly along the rounded course's points. Above the drop the levels are the creek's old profile (Christina, 2026-10-16: \"Old levels + a drop\"); from p04 on, its last reach is regraded to shore level and culverted under the Grand Circuit (\"Culvert D2\"). The one segment that passes under the lane is the culvert CX2; the point carrying weir is the controlled weir's crest; the last point is the outfall at the seaward face."
metadata/point_type = &"vector2"

