editor_description = "Directly editable pinnate palm silhouette. Twenty optional feather-frond courses let the entrance allée use a very dense, layered classic-California crown while road and Boardwalk palms retain the lighter core. Move Path3D points to reshape the head."
metadata/species_language = "classic_california_date_palm"

