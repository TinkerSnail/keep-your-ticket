[gd_scene format=3]

; Editor-owned source for the Kiddieland spatial handoff.
;
; This scene is deliberately a source rather than a runtime mount. It records
; the current built ParkPlan relationships as ordinary Godot nodes that can be
; selected and moved in the 3D editor. The HTML atlas remains a coordination
; diagram and was not traced to make this file. Source-space x/z is preserved
; here; consumers apply ParkPlan.rebuild_expand_point exactly once and derive
; height from the standing terrain.
;
; Route D, R5-R7, R14, P4 and the Kiddieland support destinations now feed the
; greybox builder. S3, Q4 and NT-2 remain context and validation boundaries.

[node name="kiddieland_layout" type="Node3D"]
editor_description = "Editor-owned source for Kiddieland. Open this scene in the Godot editor and edit the named points and footprints here, never in generated/park_routes.tscn or generated/park_program.tscn. Coordinates are rebuild-atlas source x/z before the one-time ParkPlan expansion."
metadata/coordinate_space = "rebuild_source_before_expansion"
metadata/layout_version = 2

[node name="public_routes" type="Node3D" parent="."]
editor_description = "Canonical Route D source. Its four runs remain separate because the Terraced Fountain owns the final link; the unbuilt link is protected context and is never emitted twice."

[node name="d_arrival" type="Node3D" parent="public_routes"]
metadata/route = "D"
metadata/width = 9.0
metadata/build = true

