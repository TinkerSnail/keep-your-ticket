[node name="boardwalk_pier_head" type="Node3D"]
editor_description = "Editor-owned 20 × 20m pavilion T-head. Open this scene to reshape the landing, terminal stem rails, perimeter protection and supports. The 8m generated pier deck and 12 × 13m pavilion stay fixed."
