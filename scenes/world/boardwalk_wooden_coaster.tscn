[node name="course" type="Path3D" parent="."]
curve = SubResource("Curve3D_course")
editor_description = "Canonical editable R2 circuit: station, long diagonal lift, waterfront flyover, first drop, broad north turn and separated return hills. Keep the route inside the mapped R2 parcel."
