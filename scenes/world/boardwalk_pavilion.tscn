[gd_scene load_steps=15 format=3]

; Directly editor-owned replacement for the generated terminal pavilion shell.
; Its footprint and total height preserve the protected pier composition while
; the parts below make the building legible as a maintained coastal fishing
; pavilion rather than an undecorated box.

[ext_resource type="Texture2D" path="res://assets/textures/boardwalk/weathered_boardwalk_albedo.res" id="1_weathered"]
[ext_resource type="Material" path="res://assets/materials/bulb.res" id="2_bulb"]

