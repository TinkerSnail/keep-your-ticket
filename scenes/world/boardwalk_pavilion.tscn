[node name="boardwalk_pavilion" type="Node3D"]
editor_description = "Editor-owned terminal Pier House. Open this scene to reshape its walls, roof, cupola, openings, trim, service face and fixtures. Its 12 × 13m footprint and 13m total height preserve the approved west-arch and sunset compositions."
metadata/section = &"boardwalk"
metadata/replaces_generated_nodes = "pavilion,pavilion_roof,pavilion_band,pavilion_spire,pavilion_doors"
metadata/approved_footprint_metres = Vector2(12, 13)
metadata/approved_total_height_metres = 13.0
metadata/protected_relationships = "8m_pier_stem,20m_T_head,Q3,west_arch_reveal,sunset_sector,NT-1"

