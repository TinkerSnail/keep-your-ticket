[node name="coastal_redwood_family" type="Node3D"]
editor_description = "Three directly editable coastal-redwood silhouettes for the prop catalog. Their selectable foliage sprays use layered tapered needle ribbons rather than solid wedges or cones. These are unplaced source candidates for the approved future redwood biome family."

[node name="variant_a" type="Node3D" parent="."]
position = Vector3(-12, 0, 0)
editor_description = "Old-growth high-crown redwood: strongest buttress, longest clear shaft, broken lower crown and an irregular elevated top."

