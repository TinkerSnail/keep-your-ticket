[gd_scene load_steps=10 format=3]

; Directly editor-owned primary architecture for I2, I3 and B1-B4. The stable
; park_program wrapper retires the generated walls, awnings and roofs that this
; scene replaces. Generated floors, threshold paths, counters and scheduled
; interior lights remain because they describe operations rather than form.

[ext_resource type="Texture2D" path="res://assets/textures/boardwalk/weathered_boardwalk_albedo.res" id="1_weathered"]

