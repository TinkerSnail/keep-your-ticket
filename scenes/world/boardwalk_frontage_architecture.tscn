[node name="boardwalk_frontage_architecture" type="Node3D"]
editor_description = "Directly editable Boardwalk streetwall architecture. I2, I3 and B1-B4 own their visible walls and roofs here; approved footprints remain in boardwalk_layout.tscn."
metadata/section = &"boardwalk"
metadata/layout_source = "res://scenes/world/boardwalk_layout.tscn"
metadata/replaces_generated_forms = "I2/I3 walls,awnings,roofs;midway B1-B4 walls,awnings,roofs"
metadata/protected_clearances = "NT-1,Q3,west_arch_reveal,pier_approach"

; I2 · Arcade + Ride Photo. The three-step parapet supports the existing sign
; and gives the combined use one civic-sized address without changing its
; 16 × 10m footprint or central west threshold.
[node name="I2_arcade_shell" type="Node3D" parent="."]
editor_description = "I2 primary shell: weathered timber body, west entrance, stepped parapet, roof, clerestory and east service face."

