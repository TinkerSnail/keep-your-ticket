[node name="fountain" instance=ExtResource("1_model")]
editor_description = "The plaza fountain. Shape: res://assets/source/props/plaza_fountain.blend (Send to game). Materials: res://assets/materials/plaza_fountain/, mapped by name in the GLB's import settings. The kerb and coping collide (layer 1, derived on export); parts with kyt_collision = none do not; parts with kyt_shadow = off cast no shadow (tools/kyt_part_import.gd). Stands at the park's origin: both water shaders work in world space."

