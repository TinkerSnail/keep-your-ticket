[gd_scene load_steps=4 format=3]

; Stable editor-owned wrapper. The generator writes only
; generated/park_groundworks.tscn; manual terrain refinements belong under
; authored_additions so rebuilding the measured bands cannot erase them.
; far_gain is held equal to the shader's near_gain since 2026-09-18: distance is
; the Environment's camera haze now, so the land keeps one local colour wherever
; it lies. The two materials live in assets/materials/ since 2026-10-05 (the
; same values), shared with scenes/world/world_terrain.tscn.
;
; Since 2026-10-05 (Stage 1 of documentation/terrain-master-into-game-plan-2026-10-05.md)
; the world terrain master, mounted as places/world_terrain, is the ground: the
; generator's own copies of the eight bodies it took over (the mainland reserve,
; both coasts, T2, T3, T6 and both east shoulders) are hidden here and their
; collision is switched off. The road corridor, the tunnel lids and everything
; else in this scene are unchanged. To see the generator's ground again, delete
; the `visible = false` and `disabled = true` lines below and hide
; places/world_terrain instead.
[ext_resource type="PackedScene" path="res://scenes/world/generated/park_groundworks.tscn" id="1_generated"]
[ext_resource type="Material" path="res://assets/materials/landscape_depth_vertex.tres" id="2_depth_vertex"]
[ext_resource type="Material" path="res://assets/materials/landscape_depth_plain.tres" id="3_depth_plain"]

[node name="park_groundworks" instance=ExtResource("1_generated")]

[node name="surface" parent="terrain_world_mainland_reserve" index="0"]
visible = false
material_override = ExtResource("2_depth_vertex")

[node name="shape" parent="terrain_world_mainland_reserve" index="1"]
disabled = true

[node name="surface" parent="terrain_world_coast_north" index="0"]
visible = false
material_override = ExtResource("2_depth_vertex")

[node name="shape" parent="terrain_world_coast_north" index="1"]
disabled = true

[node name="surface" parent="terrain_world_coast_south" index="0"]
visible = false
material_override = ExtResource("2_depth_vertex")

[node name="shape" parent="terrain_world_coast_south" index="1"]
disabled = true

[node name="surface" parent="terrain_road_corridor" index="0"]
material_override = ExtResource("2_depth_vertex")

[node name="surface" parent="terrain_T2_lowland" index="0"]
visible = false
material_override = ExtResource("3_depth_plain")

[node name="shape" parent="terrain_T2_lowland" index="1"]
disabled = true

[node name="surface" parent="terrain_T3_headland" index="0"]
visible = false
material_override = ExtResource("3_depth_plain")

[node name="shape" parent="terrain_T3_headland" index="1"]
disabled = true

[node name="surface" parent="terrain_T6_outer_highland" index="0"]
visible = false
material_override = ExtResource("3_depth_plain")

[node name="shape" parent="terrain_T6_outer_highland" index="1"]
disabled = true

[node name="skin" parent="east_shoulder_n" index="0"]
visible = false

[node name="shape" parent="east_shoulder_n" index="1"]
disabled = true

[node name="skin" parent="east_shoulder_s" index="0"]
visible = false

[node name="shape" parent="east_shoulder_s" index="1"]
disabled = true

[node name="authored_additions" type="Node3D" parent="."]

[editable path="terrain_world_mainland_reserve/surface"]
[editable path="terrain_world_coast_north/surface"]
[editable path="terrain_world_coast_south/surface"]
