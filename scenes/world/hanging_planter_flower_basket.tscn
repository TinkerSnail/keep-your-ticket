[node name="hanging_planter_flower_basket" type="Node3D"]
editor_description = "Catalog hanging planter with a ceiling-origin attachment, dark three-chain frame, deep cocoa-brown coir basket and selectable mixed-flower, Purple Heart and lemon-zest Hakone pockets. No world placement is implied."

