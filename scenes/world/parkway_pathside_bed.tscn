[node name="parkway_pathside_bed" type="Node3D"]
editor_description = "Catalog-only dense parkway/pathside/roadside bed. A continuous curbside Hakone ribbon, clipped green blocks directly behind it, packed hydrangea middle, airy Lily of the Nile globes, fern pockets, one classic bay laurel and an ornamental fence are independently editable."

