[node name="hakone_grass" type="Node3D"]
script = ExtResource("1_script")
editor_description = "Reusable lemon-zest Japanese forest grass source (PRP-PLANT-018 to 021). Choose vA or vB here; shape it in assets/source/props/hakone_grass.blend: reshape a blade in authored/blades and every blade of its kind follows; reshape one of the three curves in authored/courses and every course drawn from it follows. vA shows the nine outer and mature blades; vB adds three bright young ones (twelve blades)."
metadata/catalog_id = "PRP-PLANT-018"

