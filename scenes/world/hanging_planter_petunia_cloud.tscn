[node name="hanging_planter_petunia_cloud" type="Node3D"]
editor_description = "Catalog-only overflowing mixed-petunia hanging basket with a ceiling-origin attachment, dark three-chain frame, shallow charcoal bowl and a rounded ice-cream-scoop crown of individually editable five-petal blooms."

