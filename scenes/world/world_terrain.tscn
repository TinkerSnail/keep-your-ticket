[gd_scene load_steps=4 format=3]

; The world's ground, as one height grid since height-grid Stage 2 (2026-10-13,
; documentation/terrain-height-grid-plan-2026-10-12.md; Christina, 2026-10-12: "this
; multiple mesh thing is horrid"). Its source is assets/source/world_ground/: 2 m height
; tiles and a painted colour image per 1 km square, per its grid.json. Blender builds them
; into ordinary meshes (tools/blender/ground_build.py writes assets/world_ground/tiles/), and
; tools/ground_mount.gd writes scenes/world/world_ground.tscn, which mounts every tile with
; its own colour; collision is derived from each tile at import, one-sided, every face up.
; The road corridor, the tunnel portals, the west shell and both protected cascades are the
; generator's. Since Stage 6 (2026-10-15) the grid holds the natural ground under the corridor,
; which the corridor's sides are cut to, and is the hill over the tunnels. The hill lakes K1 and
; L0 and the falls' plunge pool are the world terrain master's Lakes collection, as she drew
; them, and wear the bay's water, assets/materials/lake_water.tres; they have no collision. They
; are the master's own GLB, assets/world_terrain_master.glb, which since Stage 6 exports nothing
; else: its old ground pieces are in git up to a8cd64b, the Earthworks sheet the grid took over
; up to f5a7b4b.
[ext_resource type="PackedScene" path="res://scenes/world/world_ground.tscn" id="1_ground"]
[ext_resource type="PackedScene" path="res://assets/world_terrain_master.glb" id="2_master"]
[ext_resource type="Material" path="res://assets/materials/lake_water.tres" id="3_lake"]

[node name="world_terrain" type="Node3D"]
editor_description = "The world's ground as one height grid (since 2026-10-13). Editable source: res://assets/source/world_ground/, the height and colour tiles. After changing them: Blender --background --factory-startup --python tools/blender/ground_build.py, then Godot --headless --path . --import, then Godot --headless --path . --script res://tools/ground_mount.gd, then tools/world_terrain_delta.gd to see what changed, then the generator. Roads keep their own graded profiles. The road corridor, the tunnel portals, the west shell and both protected cascades are the generator's; the grid holds the natural ground the corridor is cut into and the hill over the tunnels. The lakes are res://assets/source/world_terrain_master.blend's Lakes collection: reshape them there, then tools/export_world_source.sh assets/source/world_terrain_master.blend and import."

[node name="world_ground" parent="." instance=ExtResource("1_ground")]

[node name="lakes" parent="." instance=ExtResource("2_master")]

[node name="lake_K1" parent="lakes" index="0"]
material_override = ExtResource("3_lake")

[node name="lake_L0" parent="lakes" index="1"]
material_override = ExtResource("3_lake")

[node name="plunge_pool" parent="lakes" index="2"]
material_override = ExtResource("3_lake")

[node name="authored_additions" type="Node3D" parent="."]
