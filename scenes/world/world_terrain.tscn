[gd_scene load_steps=4 format=3]

; The world's ground, as one height grid since height-grid Stage 2 (2026-10-13,
; documentation/terrain-height-grid-plan-2026-10-12.md; Christina, 2026-10-12: "this
; multiple mesh thing is horrid"). Its source is assets/source/world_ground/: 2 m height
; tiles and a painted colour image per 1 km square, per its grid.json. Blender builds them
; into ordinary meshes (tools/blender/ground_build.py writes assets/world_ground/tiles/), and
; tools/ground_mount.gd writes scenes/world/world_ground.tscn, which mounts every tile with
; its own colour; collision is derived from each tile at import, one-sided, every face up.
; The road corridor, the tunnel lids, the west shell and both protected cascades are the
; generator's and stay as they were. The hill lakes K1 and L0 and the falls' plunge pool
; are the master's Lakes collection, exported alone to assets/world_terrain_lakes.glb, and
; wear the bay's water, assets/materials/lake_water.tres; they have no collision. Until
; Stage 5 the ground as the master's pieces is kept, unmounted, in
; scenes/world/world_terrain_pieces.tscn, for going back.
[ext_resource type="PackedScene" path="res://scenes/world/world_ground.tscn" id="1_ground"]
[ext_resource type="PackedScene" path="res://assets/world_terrain_lakes.glb" id="2_lakes"]
[ext_resource type="Material" path="res://assets/materials/lake_water.tres" id="3_lake"]

[node name="world_terrain" type="Node3D"]
editor_description = "The world's ground as one height grid (since 2026-10-13). Editable source: res://assets/source/world_ground/, the height and colour tiles. After changing them: Blender --background --factory-startup --python tools/blender/ground_build.py, then Godot --headless --path . --import, then Godot --headless --path . --script res://tools/ground_mount.gd, then tools/world_terrain_delta.gd to see what changed, then the generator. Roads keep their own graded profiles. The road corridor, the tunnel lids, the west shell and both protected cascades are not here and stay as they were."

[node name="world_ground" parent="." instance=ExtResource("1_ground")]

[node name="lakes" parent="." instance=ExtResource("2_lakes")]

[node name="lake_K1" parent="lakes" index="0"]
material_override = ExtResource("3_lake")

[node name="lake_L0" parent="lakes" index="1"]
material_override = ExtResource("3_lake")

[node name="plunge_pool" parent="lakes" index="2"]
material_override = ExtResource("3_lake")

[node name="authored_additions" type="Node3D" parent="."]
