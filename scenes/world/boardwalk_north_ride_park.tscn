[node name="boardwalk_north_ride_park" type="Node3D"]
script = ExtResource("1_script")
deck_material = SubResource("Mat_deck")
fascia_material = SubResource("Mat_fascia")
rail_material = SubResource("Mat_rail")
editor_description = "Directly editor-owned north Boardwalk ride park. Edit the open waterfront extension and the R15/R16 instance positions here; derived deck construction follows without rewriting the source."
metadata/section = &"boardwalk"
metadata/layout_version = 1
metadata/coordinate_space = &"godot_world_metres"
metadata/approved_plan = "res://documentation/maps/park-sections.html"
metadata/retains_cove_and_quay = true
metadata/route_width = 8.0
metadata/deck_top_y = -5.958

[node name="public_ride_loop" type="Path3D" parent="."]
curve = SubResource("Curve3D_loop")
editor_description = "Canonical editor-owned 8m Boardwalk extension. It continues beyond the old chain along R2's seaward edge, follows the north shoreline in open sky and meets B's land-side return beyond S1."
metadata/route = &"B"
metadata/width = 8.0
metadata/closed = false
metadata/ownership = &"editor"

[node name="derived_deck" type="Node3D" parent="."]
editor_description = "Transient wearing surface, support and outer rail derived from public_ride_loop. Edit the curve, not these children."

[node name="public_aprons" type="Node3D" parent="."]
editor_description = "Editor-owned timber forecourts joining the waterfront route to each separate ride entrance."

