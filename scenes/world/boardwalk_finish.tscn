[node name="boardwalk_finish" type="Node3D"]
editor_description = "Editor-owned material, merchandise and caused-wear layer for the Boardwalk. Open this scene to move or replace every finish piece."
metadata/section = &"boardwalk"
metadata/layout_source = "res://scenes/world/boardwalk_layout.tscn"
metadata/fidelity_pass = 5
metadata/protected_clearances = "NT-1,Q3,pier_approach,pavilion_turnaround,west_arch_reveal,sunset_sector"

