[node name="hanging_planter_fern_bowl" type="Node3D"]
editor_description = "Catalog hanging planter with a ceiling-origin brass three-chain frame, shallow warm-cream metal bowl and a very dense mature fern crown. Twenty-five selectable fans form upright, arching and trailing tiers. No world placement is implied."

