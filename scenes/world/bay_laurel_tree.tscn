[node name="bay_laurel_tree" type="Node3D"]
script = ExtResource("1_script")
bark_material = SubResource("Mat_bark")
leaf_material = SubResource("Mat_leaves")
editor_description = "Classic bay laurel with a clean trunk and hundreds of individually shaped narrow leaves derived from directly editable branch paths. Move the branch-course points to reshape the crown; no blob canopy meshes are present."

