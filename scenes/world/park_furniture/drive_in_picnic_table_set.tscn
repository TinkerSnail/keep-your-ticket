[node name="drive_in_picnic_table_set" type="Node3D"]
editor_description = "PRP-PARK-020. Late-1990s drive-in picnic-table assembly inspired by the supplied park-cafe reference: teal perforated-metal table and paired benches, black tubular frame, and an unbranded red umbrella. The source is directly editor-owned; bench seat tops are 0.51m."

