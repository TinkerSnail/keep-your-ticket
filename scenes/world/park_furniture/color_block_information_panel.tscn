[node name="color_block_information_panel" type="Node3D"]
editor_description = "PRP-PARK-023. Freestanding framed information panel with a replaceable color field and abstract type bars. Default cyan; duplicate and override accent_field for a coordinated multi-color row. Faces local +Z."

