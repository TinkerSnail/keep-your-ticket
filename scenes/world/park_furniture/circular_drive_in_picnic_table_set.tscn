[node name="circular_drive_in_picnic_table_set" type="Node3D"]
editor_description = "PRP-PARK-021. Circular companion to PRP-PARK-020: round turquoise perforated-metal tabletop, four short attached benches, black radial tubular frame, and an unbranded red centre-pole umbrella. The source is directly editor-owned; all bench seat tops are 0.51m."

