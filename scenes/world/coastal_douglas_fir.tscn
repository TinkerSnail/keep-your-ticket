[node name="coastal_douglas_fir" type="Node3D"]
editor_description = "PRP-PLANT-041. Directly editor-owned coastal Douglas fir with a tall tapering warm-bark trunk, open lower bole, fourteen interleaved whorled bough tiers and a narrow broken crown. Layered tapered needle ribbons break up every selectable spray without moving its editable silhouette. This is a catalog-only source and implies no park or range placement."

[node name="trunks" type="Node3D" parent="."]
editor_description = "Three independently selectable tapered shaft sections preserve the tree's tall, exposed-bole proportion."

