[node name="boardwalk_water_edges" type="Node3D"]
editor_description = "Editor-owned fidelity for D2 Coastal Creek and its controlled Boardwalk outfall. Move or reshape visible pieces here; edit the creek course only in fairground_layout.tscn."
metadata/section = &"boardwalk"
metadata/layout_source = "res://scenes/world/fairground_layout.tscn"
metadata/fidelity_pass = 3
metadata/protected_clearances = "NT-1,Q3,pier_turnaround,west_arch_reveal,sunset_sector"

