[node name="coastal_live_oak" type="Node3D"]
script = ExtResource("1_oak")
bark_material = SubResource("Mat_bark")
twig_material = SubResource("Mat_twig")
leaf_material = SubResource("Mat_leaf")
editor_description = "PRP-PLANT-049 California coast live oak (Quercus agrifolia). Move the five trunk and twenty-three branch Path3D courses to reshape its low fork, pale twisting scaffold and broad evergreen crown; the foliage contains no blob canopy meshes. Catalog-only and unplaced."

[node name="trunk_courses" type="Node3D" parent="."]
editor_description = "Five canonical low-forking trunk courses. These paths—not generated coordinates—own the oak's multi-stem scaffold."
