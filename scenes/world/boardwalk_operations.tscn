[node name="boardwalk_operations" type="Node3D"]
editor_description = "Editor-owned Boardwalk operating layer: R1 wheel, R2 coaster, P2 funhouse, pier fishing and visible S1/S2 handoffs."
metadata/section = &"boardwalk"
metadata/layout_source = "res://scenes/world/boardwalk_layout.tscn"
metadata/fidelity_pass = 2

[node name="R1_wheel_operations" type="Node3D" parent="."]
editor_description = "R1 raised load/unload station, north/south passenger separation, step-free lift, operator control and maintenance residue within the fixed wheel deck."

