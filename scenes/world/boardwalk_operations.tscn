[gd_scene load_steps=15 format=3]

; Editor-owned operating detail for R1, R2, P2 and the existing pier landing.
; The generated structures remain load-bearing greybox. Every visible work
; object below is directly selectable in Godot and may be reshaped by hand.

[ext_resource type="Material" path="res://assets/materials/bulb.res" id="1_bulb"]

